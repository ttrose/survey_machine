# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=sqlite:///data/survey-machine.sqlite3
# For the conventional server: postgresql://survey:password@localhost:5432/survey
# Comma-separated browser origins allowed to call the API. Same-origin needs none.
CORS_ORIGINS=
